{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/session-bootstrap.mjs"
      }
    ],
    "afterFileEdit": [
      {
        "matcher": "src\\/.*\\.(ts|tsx)|main\\.py|plugin\\.json",
        "command": "echo After Deck-facing edits: run pnpm run test:preview (requires Decky: Open Preview) or pnpm run build",
        "enabled": false
      },
      {
        "matcher": "(^|/)(main\\.py|\\.env\\.example)$|^src/|^tests/preview-suite/",
        "command": "node .cursor/hooks/regen-mcp-architecture.mjs"
      }
    ],
    "beforeShellExecution": [
      {
        "matcher": "git(\\s+-C\\s+\\S+)?\\s+push\\b",
        "command": "node .cursor/hooks/check-mcp-architecture-on-push.mjs",
        "failClosed": true
      }
    ]
  }
}
